# Пример файла с переменными окружения
# Скопируйте этот файл в .env и заполните своими значениями.
# Здесь перечислены все переменные, которые читает приложение (app/config.py).

# =========================================================================
# ОБЯЗАТЕЛЬНЫЕ (без них приложение не запустится)
# =========================================================================

# Токен Telegram бота (получить через @BotFather)
TELEGRAM_TOKEN=your_bot_token_here

# URL подключения к базе данных PostgreSQL
# Формат: postgresql://username:password@host:port/database_name
DATABASE_URL=postgresql://username:password@localhost:5432/telegram_bot_db

# =========================================================================
# АВТОРИЗАЦИЯ АДМИНКИ (опционально, но НАСТОЯТЕЛЬНО рекомендуется для прода)
# Если НЕ задать обе переменные — веб-админка и вся переписка из чатов
# будут доступны публично без пароля.
# =========================================================================

# ADMIN_USERNAME=admin
# ADMIN_PASSWORD=change_me

# =========================================================================
# OPENROUTER / LLM-аналитика (опционально)
# Без ключа функции summary / analytics / strategy будут отключены.
# =========================================================================

# OPENROUTER_API_KEY=sk-or-...
# Модель по умолчанию: openai/gpt-4o-mini
# OPENROUTER_MODEL=openai/gpt-4o-mini

# =========================================================================
# АВТО-ОТКЛОНЕНИЕ ЗАЯВОК НА ВСТУПЛЕНИЕ (опционально)
# Job запускается ТОЛЬКО если задан VIBECODER_CHAT_ID.
# Бот должен быть админом чата с правом одобрять заявки.
# =========================================================================

# ID чата, для которого включается авто-модерация заявок (для групп — отрицательный)
# VIBECODER_CHAT_ID=-1001234567890

# Порог "свежести" аккаунта: заявки с user_id выше порога считаются свежими
# FRESH_ACCOUNT_ID_THRESHOLD=7000000000

# Интервал запуска job очистки заявок, сек
# JOIN_REQUEST_CLEAN_INTERVAL_SEC=60

# Максимум заявок, обрабатываемых за один проход
# JOIN_REQUEST_CLEAN_BATCH_LIMIT=100

# Путь к файлу лога отклонённых заявок
# DECLINED_REQUESTS_LOG_PATH=logs/declined_requests.log

# =========================================================================
# СЕРВЕР И ЛОГИРОВАНИЕ (опционально)
# =========================================================================

# Порт HTTP-сервера (на Railway определяется автоматически, по умолчанию 8000)
# PORT=8000

# Уровень логирования: DEBUG / INFO / WARNING / ERROR (по умолчанию INFO)
# LOG_LEVEL=INFO

# =========================================================================
# Примеры различных форматов DATABASE_URL
# =========================================================================
# Локальная база данных:
# DATABASE_URL=postgresql://postgres:password@localhost:5432/telegram_bot

# База данных на удалённом сервере:
# DATABASE_URL=postgresql://user:pass@remote-host:5432/dbname

# База данных с SSL:
# DATABASE_URL=postgresql://user:pass@host:5432/dbname?sslmode=require
